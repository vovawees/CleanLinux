#!/usr/bin/env bash
# burn - the CleanLinux package manager (bash prototype)
# SPDX-License-Identifier: MIT
set -o errexit -o nounset -o pipefail
# inherit_errexit: a failing command inside $(...) fails the substitution too
shopt -s nullglob extglob inherit_errexit

BURN_VERSION=0.3.0
BURN_SELF=$(readlink -f "${BASH_SOURCE[0]}")
BURN_HOME=${BURN_HOME:-${BURN_SELF%/*}}

for _lib in "$BURN_HOME"/lib/*.sh; do
	# shellcheck source=/dev/null
	. "$_lib"
done
unset _lib

burn_main "$@"