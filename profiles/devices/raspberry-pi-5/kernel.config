# Raspberry Pi 5: the root may live on the SD card (built in already), on an NVMe drive on the
# PCIe connector or on a USB drive behind RP1, the south bridge on PCIe. Without an initramfs
# the PCIe host, RP1 and its clocks and pins must be built in (the arm64 defconfig makes them
# modules).
CONFIG_PCIE_BRCMSTB=y
CONFIG_MISC_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_BLK_DEV_NVME=y
# cameras: the RP1 camera front end and the PiSP back end (the ISP)
CONFIG_VIDEO_RP1_CFE=m
CONFIG_VIDEO_RASPBERRYPI_PISP_BE=m
