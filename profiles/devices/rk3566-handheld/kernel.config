# RK3566 handhelds: Anbernic RG353P/PS/V/VS, RG503, RG ARC-D/S; PowKiddy RGB30, RGB10MAX3,
# RGB20SX, RK2023, X55. The drivers of their device trees (boards: tools/dt-kconfig.py, run by
# tests/kernel-config.sh) that the arm64 defconfig leaves out. The SD card, the eMMC and all they
# need (clocks, the RK817 PMIC's regulators on I2C, pins, power domains) are built in already:
# the root mounts without an initramfs.

# panels: MIPI DSI (RG353, RG ARC, RK2023, X55) and the RG503's AMOLED, set up over a GPIO SPI bus
CONFIG_DRM_PANEL_NEWVISION_NV3051D=m
CONFIG_DRM_PANEL_SITRONIX_ST7701=m
CONFIG_DRM_PANEL_SITRONIX_ST7703=m
CONFIG_DRM_PANEL_HIMAX_HX8394=m
CONFIG_DRM_PANEL_MAGNACHIP_D53E6EA8966=m
CONFIG_SPI_GPIO=m
# controls: the analog sticks on the SAR ADC behind an analog multiplexer, the buttons on GPIOs,
# the touchscreen of the RG353P/V
CONFIG_JOYSTICK_ADC=m
CONFIG_IIO_MUX=m
CONFIG_KEYBOARD_GPIO=y
CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=m
# Wi-Fi + Bluetooth on SDIO and the 3-wire UART (H5): RTL8821CS (Anbernic, PowKiddy RGB30, RK2023,
# X55), RTL8723DS (RGB10MAX3, RGB20SX)
CONFIG_RTW88_8821CS=m
CONFIG_RTW88_8723DS=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
# battery and charger, sound: the RK817 PMIC
CONFIG_CHARGER_RK817=m
CONFIG_SND_SOC_RK817=m
