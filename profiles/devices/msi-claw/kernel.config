# MSI Claw A1M (MS-1T41): the drivers of the device (the generic images have them too, through
# x86.config; tests/kernel-config.sh checks the list). The panel is landscape; the face buttons
# of the keyboard interface come with the hwdb of eudev.

# the controller: its modes and RGB (hid-msi) and the Xbox 360 gamepad (XInput mode)
CONFIG_HID_MSI=m
CONFIG_JOYSTICK_XPAD=m
# platform: fans and sensors (msi-wmi-platform); Intel: s2idle residency (PMC core), the power
# and volume buttons (HID event, VBTN)
CONFIG_MSI_WMI_PLATFORM=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
# graphics: Meteor Lake on i915
CONFIG_DRM_I915=m
# sound: Sound Open Firmware for Meteor Lake, the HD-audio codec on its HDA link
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
# Wi-Fi + Bluetooth: Intel (iwlwifi with both firmware APIs, btintel over USB)
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_BT_HCIBTUSB=m
# power: RAPL limits (powercap), CPU temperature
CONFIG_INTEL_RAPL=m
CONFIG_SENSORS_CORETEMP=m
