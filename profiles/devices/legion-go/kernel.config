# Lenovo Legion Go (83E1): the drivers of the device (the generic images have them too, through
# x86.config; tests/kernel-config.sh checks the list). The panel is mounted portrait:
# drm_panel_orientation_quirks of the kernel know it; the accelerometer's mount matrix and the
# extra keys come with the hwdb of eudev.

# platform: platform_profile (GameZone) and the TDP limits as firmware attributes (Other Mode)
CONFIG_LENOVO_WMI_GAMEZONE=m
CONFIG_LENOVO_WMI_TUNING=m
# the detachable controllers: their settings (hid-lenovo-go) and the Xbox 360 gamepad
CONFIG_HID_LENOVO_GO=m
CONFIG_JOYSTICK_XPAD=m
# screen rotation: the accelerometer behind the AMD Sensor Fusion Hub (HID sensors, IIO)
CONFIG_AMD_SFH_HID=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ACCEL_3D=m
# sound: Realtek HD-audio codec and two CS35L41 amplifiers on I2C (one ACPI node, CSC3551)
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SERIAL_MULTI_INSTANTIATE=m
# Wi-Fi + Bluetooth: MediaTek MT7922
CONFIG_MT7921E=m
CONFIG_BT_HCIBTUSB_MTK=y
# power: amd-pstate EPP, the power framework (PMF), s2idle (PMC), CPU temperature
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMF=m
CONFIG_AMD_PMC=m
CONFIG_SENSORS_K10TEMP=m
