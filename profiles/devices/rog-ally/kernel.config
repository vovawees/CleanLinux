# ASUS ROG Ally (RC71L) and ROG Ally X (RC72LA): the drivers of the device (the generic images
# have them too, through x86.config; tests/kernel-config.sh checks the list). The panel is
# landscape; the IMU's mount matrix of the Ally X comes with the hwdb of eudev.

# platform: hotkeys and platform_profile (asus-nb-wmi), the TDP limits and the controller's
# settings as firmware attributes (asus-armoury)
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_ARMOURY=m
# the controller: the N-Key HID device (extra buttons, RGB) and its Xbox 360 gamepad
CONFIG_HID_ASUS=m
CONFIG_JOYSTICK_XPAD=m
# the IMU (Bosch BMI323 on I2C): screen rotation
CONFIG_BMI323_I2C=m
# sound: Realtek HD-audio codec and two CS35L41 amplifiers on I2C, one ACPI node (CSC3551) that
# serial-multi-instantiate splits into the two devices
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SERIAL_MULTI_INSTANTIATE=m
# Wi-Fi + Bluetooth: MediaTek MT7922
CONFIG_MT7921E=m
CONFIG_BT_HCIBTUSB_MTK=y
# power: amd-pstate EPP, the power framework (PMF), s2idle (PMC), CPU temperature
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMF=m
CONFIG_AMD_PMC=m
CONFIG_SENSORS_K10TEMP=m
