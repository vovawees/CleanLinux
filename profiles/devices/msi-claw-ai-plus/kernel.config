# MSI Claw 7 AI+ / 8 AI+ (MS-1T42, MS-1T52): the drivers of the device (the generic images have
# them too, through x86.config; tests/kernel-config.sh checks the list). The face buttons of the
# keyboard interface come with the hwdb of eudev.

# the controller: its modes and RGB (hid-msi) and the Xbox 360 gamepad (XInput mode)
CONFIG_HID_MSI=m
CONFIG_JOYSTICK_XPAD=m
# platform: fans and sensors (msi-wmi-platform); Intel: s2idle residency (PMC core), the power
# and volume buttons (HID event, VBTN)
CONFIG_MSI_WMI_PLATFORM=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
# graphics: Lunar Lake (Xe2) on xe
CONFIG_DRM_XE=m
# sound: Sound Open Firmware for Lunar Lake, SoundWire and the HDA link
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
# Wi-Fi 7 + Bluetooth: Intel BE201 (iwlwifi, the MLD firmware API; btintel over USB)
CONFIG_IWLWIFI=m
CONFIG_IWLMLD=m
CONFIG_BT_HCIBTUSB=m
# power: RAPL limits (powercap), CPU temperature
CONFIG_INTEL_RAPL=m
CONFIG_SENSORS_CORETEMP=m
