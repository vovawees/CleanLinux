# ASUS ROG Xbox Ally X and Lenovo Legion Go 2 (83N0, 83N1): the drivers of the devices (the
# generic images have them too, through x86.config; tests/kernel-config.sh checks the list).
# The power button long press of the Legion Go 2 is mapped by the hwdb of eudev.

# platform: ASUS (asus-nb-wmi, asus-armoury) and Lenovo (GameZone, Other Mode): platform_profile
# and the TDP limits as firmware attributes
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_ARMOURY=m
CONFIG_LENOVO_WMI_GAMEZONE=m
CONFIG_LENOVO_WMI_TUNING=m
# the controllers: ASUS N-Key HID device, the detachable Legion Go 2 controllers, Xbox gamepads
CONFIG_HID_ASUS=m
CONFIG_HID_LENOVO_GO=m
CONFIG_JOYSTICK_XPAD=m
# sound: HD-audio codecs with their I2C amplifiers (one ACPI node per pair), the DSP of ACP 7.x
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SERIAL_MULTI_INSTANTIATE=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
CONFIG_SND_SOC_AMD_PS=m
# Wi-Fi + Bluetooth: MediaTek MT7925
CONFIG_MT7925E=m
CONFIG_BT_HCIBTUSB_MTK=y
# power: amd-pstate EPP, the power framework (PMF), s2idle (PMC: the Legion Go 2 has a quirk
# there), CPU temperature
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMF=m
CONFIG_AMD_PMC=m
CONFIG_SENSORS_K10TEMP=m
