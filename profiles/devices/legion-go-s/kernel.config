# Lenovo Legion Go S (83L3, 83N6, 83Q2, 83Q3): the drivers of the device (the generic images have
# them too, through x86.config; tests/kernel-config.sh checks the list). The extra keys come with
# the hwdb of eudev.

# platform: platform_profile (GameZone) and the TDP limits as firmware attributes (Other Mode)
CONFIG_LENOVO_WMI_GAMEZONE=m
CONFIG_LENOVO_WMI_TUNING=m
# the controller: its settings (hid-lenovo-go-s) and the Xbox 360 gamepad
CONFIG_HID_LENOVO_GO_S=m
CONFIG_JOYSTICK_XPAD=m
# sound: HD-audio codec; the digital microphones on ACP 6.x (the acp6x machine driver knows the
# Go S by its DMI product names)
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
# Wi-Fi + Bluetooth: MediaTek MT7922
CONFIG_MT7921E=m
CONFIG_BT_HCIBTUSB_MTK=y
# power: amd-pstate EPP, the power framework (PMF), s2idle (PMC), CPU temperature
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMF=m
CONFIG_AMD_PMC=m
CONFIG_SENSORS_K10TEMP=m
