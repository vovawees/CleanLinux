# Valve Steam Deck, LCD (Jupiter) and OLED (Galileo): the drivers of the device. Most of them are
# in x86.config of the recipe linux too, so that the generic images run on it; this is the
# device's own list, and tests/kernel-config.sh checks that its kernel gets every option.
# The panel is mounted portrait: drm_panel_orientation_quirks of the kernel know both models, and
# the compositors turn the picture by the panel's orientation property.

# the controller without Steam: gamepad, trackpads and gyro (hid-steam), with rumble
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y
# sound: ACP 5.x (Van Gogh) with the NAU8821 headset codec. LCD: two CS35L41 amplifiers on the
# SPI controller of the APU (acp5x machine driver); OLED: MAX98388 amplifiers through Sound Open
# Firmware
CONFIG_SND_SOC_AMD_ACP5x=m
CONFIG_SND_SOC_AMD_VANGOGH_MACH=m
CONFIG_SPI_MEM=y
CONFIG_SPI_AMD=m
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_VANGOGH=m
CONFIG_SND_SOC_AMD_SOF_MACH=m
# Wi-Fi + Bluetooth: Realtek RTL8822CE (LCD), Qualcomm QCA2066 on ath11k (OLED)
CONFIG_RTW88_8822CE=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
# the microSD slot (sdhci-pci): a root on the card mounts without an initramfs
CONFIG_MMC_SDHCI_PCI=y
# power: amd-pstate EPP, CPU temperature
CONFIG_X86_AMD_PSTATE=y
CONFIG_SENSORS_K10TEMP=m
